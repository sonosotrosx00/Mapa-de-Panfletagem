{
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/mapas/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/pdf/(.*)", "headers": [{ "key": "Content-Disposition", "value": "attachment" }] }
  ]
}
